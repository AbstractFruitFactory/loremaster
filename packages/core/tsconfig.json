{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"rootDir": "src",
		"outDir": "dist",
		"strict": true,
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.spec.ts"]
}
