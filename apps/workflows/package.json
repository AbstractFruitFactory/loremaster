{
	"name": "@loremaster/workflows",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "node --env-file=../../.env --import tsx src/main.ts",
		"build": "tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"start": "NODE_ENV=production node dist/main.js",
		"test": "vitest --run"
	},
	"dependencies": {
		"@dbos-inc/dbos-sdk": "^5.0.2",
		"@loremaster/core": "workspace:*",
		"effect": "^3.22.1"
	},
	"devDependencies": {
		"@types/node": "^24",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
