{
	"name": "loremaster",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "MOCK_AI_PROVIDER=true vite-node --config scripts/vite.config.ts scripts/seed-test-campaign.ts",
		"db:studio": "drizzle-kit studio",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "latest",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-svelte-csf": "latest",
		"@storybook/addon-vitest": "^10.5.10",
		"@storybook/sveltekit": "^10.5.10",
		"@sveltejs/adapter-auto": "next",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-v8": "4.1.10",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"playwright": "latest",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sass": "^1.103.1",
		"storybook": "^10.5.10",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-node": "^6.0.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/cormorant-garamond": "^5.3.0",
		"@fontsource/source-sans-3": "^5.3.0",
		"@iconify/svelte": "^5.2.2",
		"@mastra/pg": "^1.22.2",
		"@mastra/rag": "^2.6.0",
		"effect": "^3.22.1",
		"openai": "^7.8.0",
		"postgres": "^3.4.9",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	}
}
