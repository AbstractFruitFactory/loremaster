{
	"name": "loremaster",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "pnpm --filter @loremaster/core build && pnpm --parallel --filter @loremaster/core --filter @loremaster/web --filter @loremaster/workflows dev",
		"dev:web": "pnpm --filter @loremaster/core build && pnpm --filter @loremaster/web dev",
		"dev:workflows": "pnpm --filter @loremaster/core build && pnpm --filter @loremaster/workflows dev",
		"preview": "pnpm --filter @loremaster/web preview",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "pnpm -r --if-present test",
		"test:server": "pnpm --filter @loremaster/web exec vitest --run --project server",
		"db:push": "pnpm --filter @loremaster/web db:push",
		"db:generate": "pnpm --filter @loremaster/web db:generate",
		"db:migrate": "pnpm --filter @loremaster/web db:migrate",
		"db:reindex-vaults": "pnpm --filter @loremaster/web db:reindex-vaults",
		"db:seed": "pnpm --filter @loremaster/web db:seed",
		"db:studio": "pnpm --filter @loremaster/web db:studio",
		"storybook": "pnpm --filter @loremaster/web storybook",
		"build-storybook": "pnpm --filter @loremaster/web build-storybook"
	},
	"devDependencies": {
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0"
	}
}
